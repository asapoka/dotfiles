# 設定のキー一覧
# ghostty +list-keybinds

# アクション一覧
# ghostty +list-actions


# テーマ
theme = Iceberg Dark
# 利用可能なテーマ一覧
# ghostty +list-themes

# 言語
language = ja

# フォント
font-family = "HackGen Console NF"
font-size = 14

maximize = true
window-subtitle = working-directory

# 背景の透過度（0.0 〜 1.0）
background-opacity = 0.85

# クリップボードの読み書きを許可
clipboard-read = allow
clipboard-write = allow

# キーバインド
# 水平分割
keybind = ctrl+shift+-=new_split:down
# 垂直分割
keybind = ctrl+shift+¥=new_split:right
# ペイン間を移動
keybind = ctrl+alt+left=goto_split:left
keybind = ctrl+alt+right=goto_split:right
keybind = ctrl+alt+up=goto_split:top
keybind = ctrl+alt+down=goto_split:bottom
# ペイン間を閉じる
keybind = ctrl+w=close_surface
